---
// Секция главной. Номер берётся из порядка секций в src/lib/sections.ts, заголовок из словаря.
import { useTranslations, type Locale } from '../../i18n';
import { sections } from '../../lib/sections';
import SectionBlock from '../SectionBlock.astro';

interface Props {
  lang: Locale;
  id: string;
}

const { lang, id } = Astro.props;
const t = useTranslations(lang);

const position = sections.findIndex((section) => section.id === id);
if (position === -1) throw new Error(`Секции «${id}» нет в src/lib/sections.ts`);
const section = sections[position]!;
---

<SectionBlock id={id} index={position + 1} title={t(section.title)}>
  <slot />
</SectionBlock>
