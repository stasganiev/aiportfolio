---
// «Курсы»: две карточки из courses.yaml и отзывы выпускников из testimonials.yaml.
// Дат потоков и статусов набора здесь нет: расписание живёт на лендингах школы.
// Курсы ведутся на русском: на английской и сербской страницах название переведено,
// под ним стоит русский оригинал с пометкой языка, отзывы подписаны как перевод.
import { courses, testimonials } from '../../data';
import { useTranslations, type Locale } from '../../i18n';
import { fill, plural } from '../../lib/format';
import type { HomeTexts } from '../../texts';
import Section from './Section.astro';

interface Props {
  lang: Locale;
  texts: HomeTexts['courses'];
}

const { lang, texts } = Astro.props;
const t = useTranslations(lang);
const translated = lang !== 'ru';

const count = (n: number, forms: HomeTexts['courses']['modules']) => `${n} ${plural(lang, n, forms)}`;
---

<Section lang={lang} id="courses">
  <p class="section-lead">{texts.lead}</p>

  <div class="duo">
    {
      courses.map((course) => {
        const title = lang === 'ru' ? course.title : course.title_translation[lang];
        return (
          <article class="card">
            <p class="label">
              {count(course.modules, texts.modules)} · {count(course.lessons, texts.lessons)}
            </p>
            <h3>{title}</h3>
            {translated && (
              <p class="original">
                <span lang="ru">{course.title}</span> · {t('material.inRussian')}
              </p>
            )}
            <p class="card-for">{course.audience[lang]}</p>
            <ul class="dash-list">
              {course.outcomes.map((outcome) => (
                <li>{outcome[lang]}</li>
              ))}
            </ul>
            <p class="card-note">
              <span>{texts.format}</span> {course.format[lang]}
            </p>
            <a class="button button-ghost" href={course.landing} hreflang="ru">
              {texts.button}
              <span class="visually-hidden">: {title}</span>
            </a>
          </article>
        );
      })
    }
  </div>

  <h3 class="subhead">{texts.testimonials_title}</h3>
  <div class="quotes">
    {
      testimonials.map((item) => (
        <figure class="quote">
          <blockquote>{item.quote[lang]}</blockquote>
          <figcaption>
            {item.author[lang]}, {item.course_label[lang]}, {fill(texts.cohort, { n: item.cohort }, lang)}
            {translated && <> · {t('testimonial.translated')}</>}
          </figcaption>
        </figure>
      ))
    }
  </div>
</Section>
