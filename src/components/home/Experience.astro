---
// «Опыт»: хронология из experience.yaml, от нового к старому.
// Цифры в достижениях подставляются из facts.yaml и набираются крупнее текста.
import { experience } from '../../data';
import type { Locale } from '../../i18n';
import { escapeHtml } from '../../lib/format';
import { fillFacts, type HomeTexts } from '../../texts';
import Section from './Section.astro';

interface Props {
  lang: Locale;
  texts: HomeTexts['experience'];
  /** Язык данных об опыте: пока они есть только на русском. */
  textsLocale: Locale;
}

const { lang, texts, textsLocale } = Astro.props;

// Сколько мест работы видно сразу. Остальные раскрываются кнопкой.
const shownAtOnce = 3;
const groups = [experience.slice(0, shownAtOnce), experience.slice(shownAtOnce)] as const;

const withFigures = (text: string) =>
  fillFacts(escapeHtml(text), textsLocale, {
    where: 'src/data/experience.yaml',
    // Год в дате остаётся обычным текстом: крупно набираются только показатели.
    markNumber: (number, key) => (key === 'sinceYear' ? number : `<b class="num">${number}</b>`),
  });
---

<Section lang={lang} id="experience">
  <p class="section-lead">{texts.lead}</p>

  {
    groups.map((jobs, index) => {
      const list = (
        <ol class="xp-list">
          {jobs.map((job) => (
            <li class="xp">
              <div>
                <p class="xp-period">{job.period}</p>
                <h3>{job.company}</h3>
                <p class="xp-about">{job.about}</p>
              </div>
              <div>
                <p class="xp-role">{job.role}</p>
                <p>{job.summary}</p>
                <ul class="dash-list">
                  {job.highlights.map((highlight) => (
                    <li set:html={withFigures(highlight)} />
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      );
      if (index === 0) return list;
      return (
        jobs.length > 0 && (
          <details class="more">
            <summary class="button button-ghost">
              {texts.all}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </summary>
            {list}
          </details>
        )
      );
    })
  }
</Section>
