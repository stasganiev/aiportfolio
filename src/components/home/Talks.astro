---
// «Выступления и статьи»: избранное на виду, остальное раскрывается кнопкой.
// Списки берутся из talks.yaml и articles.yaml, сверху новые.
import { Picture } from 'astro:assets';

import stage from '../../assets/photos/stage.jpg';
import Entry from '../Entry.astro';
import { localePath, type Locale } from '../../i18n';
import { articleEntries, talkEntries } from '../../lib/talks';
import { useTranslations } from '../../i18n';
import type { HomeTexts } from '../../texts';
import Section from './Section.astro';

interface Props {
  lang: Locale;
  texts: HomeTexts['talks'];
}

const { lang, texts } = Astro.props;

const note = useTranslations(lang)('material.inRussian');
const talkList = talkEntries(texts, lang, note);
const articleList = articleEntries(texts, lang, note);
---

<Section lang={lang} id="talks">
  <p class="section-lead">{texts.lead}</p>
  <p class="talks-about">{texts.about}</p>

  <div class="talks-grid">
    <div class="talks-col">
      <h3 class="subhead">{texts.featured_talks}</h3>
      <ul class="entries">
        {talkList.filter((item) => item.featured).map((item) => <Entry title={item.title} original={item.original} meta={item.meta} links={item.links} />)}
      </ul>
      <details class="more">
        <summary class="button button-ghost">
          {texts.all_talks}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </summary>
        <ul class="entries">
          {talkList.filter((item) => !item.featured).map((item) => <Entry title={item.title} original={item.original} meta={item.meta} links={item.links} />)}
        </ul>
      </details>

      <h3 class="subhead">{texts.featured_articles}</h3>
      <ul class="entries">
        {articleList.filter((item) => item.featured).map((item) => <Entry title={item.title} original={item.original} href={item.href} meta={item.meta} links={item.links} />)}
      </ul>
      <details class="more">
        <summary class="button button-ghost">
          {texts.all_articles}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </summary>
        <ul class="entries">
          {articleList.filter((item) => !item.featured).map((item) => <Entry title={item.title} original={item.original} href={item.href} meta={item.meta} links={item.links} />)}
        </ul>
      </details>
    </div>

    <div class="talks-aside">
      <figure class="frame">
        <Picture
          src={stage}
          formats={['avif', 'webp']}
          widths={[380, 704]}
          sizes="(max-width: 1040px) min(420px, calc(100vw - 44px)), 380px"
          alt={texts.photo_alt}
          loading="lazy"
        />
        <figcaption>{texts.photo_caption}</figcaption>
      </figure>
      <a class="button button-ghost" href={localePath(lang, 'speaker/')}>{texts.invite}</a>
    </div>
  </div>
</Section>
