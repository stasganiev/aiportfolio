---
// «Выступления и статьи»: избранное на виду, остальное раскрывается кнопкой.
// Списки берутся из talks.yaml и articles.yaml, сверху новые.
import { Picture } from 'astro:assets';

import stage from '../../assets/photos/stage.jpg';
import { articles, talks } from '../../data';
import { localePath, type Locale } from '../../i18n';
import type { HomeTexts } from '../../texts';
import Entry from './Entry.astro';
import Section from './Section.astro';

interface Props {
  lang: Locale;
  texts: HomeTexts['talks'];
}

const { lang, texts } = Astro.props;
const home = localePath(lang);

const newestFirst = <T extends { date: string }>(items: T[]) =>
  [...items].sort((a, b) => b.date.localeCompare(a.date));
const year = (date: string) => date.slice(0, 4);

const talkEntries = newestFirst(talks).map((talk) => ({
  featured: talk.featured === true,
  title: talk.title,
  meta: [talk.venue, talk.place, year(talk.date)],
  links: [
    { label: texts.video, url: talk.video },
    { label: texts.slides, url: talk.slides },
    { label: texts.article, url: talk.article },
  ].flatMap((link) => (link.url ? [{ label: link.label, url: link.url }] : [])),
}));

const articleEntries = newestFirst(articles).map((article) => ({
  featured: article.featured === true,
  title: article.title,
  href: article.url,
  meta: [article.publisher, year(article.date), article.award].filter((part) => part !== undefined),
  links: article.url_part_2 ? [{ label: texts.part_2, url: article.url_part_2 }] : [],
}));
---

<Section lang={lang} id="talks">
  <p class="section-lead">{texts.lead}</p>
  <p class="talks-about">{texts.about}</p>

  <div class="talks-grid">
    <div class="talks-col">
      <h3 class="subhead">{texts.featured_talks}</h3>
      <ul class="entries">
        {talkEntries.filter((item) => item.featured).map((item) => <Entry {...item} />)}
      </ul>
      <details class="more">
        <summary class="button button-ghost">
          {texts.all_talks}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </summary>
        <ul class="entries">
          {talkEntries.filter((item) => !item.featured).map((item) => <Entry {...item} />)}
        </ul>
      </details>

      <h3 class="subhead">{texts.featured_articles}</h3>
      <ul class="entries">
        {articleEntries.filter((item) => item.featured).map((item) => <Entry {...item} />)}
      </ul>
      <details class="more">
        <summary class="button button-ghost">
          {texts.all_articles}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </summary>
        <ul class="entries">
          {articleEntries.filter((item) => !item.featured).map((item) => <Entry {...item} />)}
        </ul>
      </details>
    </div>

    <div class="talks-aside">
      <figure class="frame">
        <Picture
          src={stage}
          formats={['avif', 'webp']}
          widths={[380, 704]}
          sizes="(max-width: 1040px) min(420px, calc(100vw - 44px)), 380px"
          alt={texts.photo_alt}
          loading="lazy"
        />
        <figcaption>{texts.photo_caption}</figcaption>
      </figure>
      {/* До этапа 6 страницы спикера нет, кнопка ведёт к контактам. */}
      <a class="button button-ghost" href={`${home}#contact`}>{texts.invite}</a>
    </div>
  </div>
</Section>
