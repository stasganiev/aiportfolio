---
// Подвал: копирайт с годом сборки, короткое меню и ссылки на соцсети из links.yaml.
import { contact } from '../data';
import { localePath, useTranslations, type Locale } from '../i18n';
import { tr } from '../lib/localized';
import { sections } from '../lib/sections';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);
const year = new Date().getFullYear();
const social = ['telegram', 'linkedin', 'github'].map(contact);
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <span>© {year} {t('brand.name')}</span>
    <nav class="footer-nav" aria-label={t('footer.nav')}>
      {sections.map((section) => section.nav && <a href={`${home}#${section.id}`}>{t(section.nav)}</a>)}
    </nav>
    <span class="footer-links">
      {social.map((item) => <a href={item.url} rel="me noopener">{tr(item.label, lang)}</a>)}
    </span>
  </div>
</footer>
