---
// Подвал: копирайт с годом сборки и ссылки на соцсети из links.yaml.
import { contact } from '../data';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const t = useTranslations(Astro.props.lang);
const year = new Date().getFullYear();
const social = ['telegram', 'linkedin', 'github'].map(contact);
---

<footer class="site-footer">
  <div class="wrap footer-row">
    <span>© {year} {t('brand.name')}</span>
    <span class="footer-links">
      {social.map((item) => <a href={item.url} rel="me noopener">{item.label}</a>)}
    </span>
  </div>
</footer>
