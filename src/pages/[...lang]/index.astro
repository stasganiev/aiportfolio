---
// Главная на трёх языках: / (EN), /ru/, /sr/.
// Порядок секций совпадает со списком в src/lib/sections.ts.
import About from '../../components/home/About.astro';
import Companies from '../../components/home/Companies.astro';
import Contact from '../../components/home/Contact.astro';
import Courses from '../../components/home/Courses.astro';
import Experience from '../../components/home/Experience.astro';
import Hero from '../../components/home/Hero.astro';
import Now from '../../components/home/Now.astro';
import OpenSource from '../../components/home/OpenSource.astro';
import Talks from '../../components/home/Talks.astro';
import { defaultLocale, locales, type Locale } from '../../i18n';
import Base from '../../layouts/Base.astro';
import { homeTexts } from '../../texts';

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang: lang === defaultLocale ? undefined : lang },
    props: { lang },
  }));
}

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const { texts, locale: textsLocale, translated } = homeTexts(lang);
---

<Base lang={lang} title={texts.meta.title} description={texts.meta.description} translated={translated}>
  <Hero lang={lang} texts={texts.hero} textsLocale={textsLocale} />
  <Now lang={lang} texts={texts.now} />
  <Courses lang={lang} texts={texts.courses} textsLocale={textsLocale} />
  <Companies lang={lang} texts={texts.companies} />
  <OpenSource lang={lang} texts={texts.open_source} />
  <Talks lang={lang} texts={texts.talks} />
  <Experience lang={lang} texts={texts.experience} textsLocale={textsLocale} />
  <About lang={lang} texts={texts.about} />
  <Contact lang={lang} texts={texts.contact} />
</Base>
